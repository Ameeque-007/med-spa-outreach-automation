    {
      "parameters": {
        "jsCode": "// Match inbox senders against the leads sheet by email address.\n// Wrapped in try/catch so a node that didn't execute in this run\n// (e.g. tested in isolation, or IMAP timed out) returns an empty\n// list instead of crashing the whole workflow.\nlet emailItems = [];\ntry {\n  emailItems = $('Check Inbox (IMAP)').all();\n} catch (e) {\n  emailItems = [];\n}\n\nlet leadItems = [];\ntry {\n  leadItems = $('Read Leads Sheet').all();\n} catch (e) {\n  leadItems = [];\n}\n\nif (emailItems.length === 0 || leadItems.length === 0) {\n  return [];\n}\n\n// Only look at messages received since the last check (defensive filter\n// in case markSeen/read state gets reset or IMAP re-delivers).\nconst twoHoursAgo = new Date(Date.now() - 2.5 * 60 * 60 * 1000);\n\nconst leadEmails = new Map();\nfor (const lead of leadItems) {\n  const email = (lead.json.Email || '').toLowerCase().trim();\n  if (email) leadEmails.set(email, lead.json);\n}\n\nconst matchedEmails = new Set();\nconst matched = [];\n\nfor (const msg of emailItems) {\n  const fromHeader = (msg.json.from || msg.json.From || '').toLowerCase();\n\n  // Skip clearly stale messages if a date field is present\n  const msgDate = msg.json.date ? new Date(msg.json.date) : null;\n  if (msgDate && msgDate < twoHoursAgo) continue;\n\n  for (const [email] of leadEmails.entries()) {\n    if (fromHeader.includes(email) && !matchedEmails.has(email)) {\n      matchedEmails.add(email);\n      matched.push({\n        json: {\n          Email: email,\n          Status: 'Replied',\n          LastContactDate: new Date().toISOString().split('T')[0]\n        }\n      });\n    }\n  }\n}\n\nreturn matched;"
      },
