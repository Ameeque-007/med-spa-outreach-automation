      "id": "f20c5cbc-ec72-4d88-a0a7-a1ab1532e47f",
      "name": "Daily Trigger (7AM)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -752,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "// ============================================\n// EDIT ME: paste your Google Alerts RSS feed URLs here.\n// One object per alert. 'city' and 'signal_type' get tagged\n// onto every article found in that feed, so you can filter/\n// score later. Add or remove rows as you set up more alerts.\n// ============================================\nconst feeds = [\n {\n    url:          'YOUR_GOOGLE_ALERTS_FEED_URL_HERE',\n    city: 'Austin, TX',\n    signal_type: 'new_opening',\n    source_query: '\"new med spa\" Austin'\n},\n  {\n    url: 'YOUR_GOOGLE_ALERTS_FEED_URL_HERE',\n    city: 'Austin, TX',\n    signal_type: 'hiring_post',\n    source_query: '\"med spa\" \"front desk\" hiring Austin'\n  },\n  {\n    url: 'YOUR_GOOGLE_ALERTS_FEED_URL_HERE',\n    city: 'Nashville, TN',\n    signal_type: 'new_opening',\n    source_query: '\"new med spa\" Nashville'\n  },\n  {\n    url: 'YOUR_GOOGLE_ALERTS_FEED_URL_HERE',\n    city: 'Nashville, TN',\n    signal_type: 'hiring_post',\n    source_query: '\"medical spa\" \"now hiring\" receptionist Nashville'\n  },\n  {\n    url: 'YOUR_GOOGLE_ALERTS_FEED_URL_HERE',\n    city: 'Charlotte, NC',\n    signal_type: 'new_opening',\n    source_query: '\"med spa\" \"now open\" Charlotte'\n  }\n];\n\nreturn feeds.map(f => ({ json: f }));"
      },
      "id": "9047dcc5-c864-47c2-8750-4de665467559",
      "name": "RSS Feed List (EDIT ME)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        128
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "b6f97b1e-4e50-4fe9-b84a-cd9172bd4579",
      "name": "Loop Over Feeds",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -256,
        -16
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 15000
        }
      },
      "id": "1a9c3b37-4176-4985-a24f-b7f3e8f62e28",
      "name": "Fetch RSS Feed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.data || '';\nconst meta = $('RSS Feed List (EDIT ME)').item.json;\n\nfunction extractTag(block, tag) {\n  const match = block.match(new RegExp(`<${tag}[^>]*>([\\\\s\\\\S]*?)</${tag}>`));\n  if (!match) return '';\n  return match[1].replace('<![CDATA[', '').replace(']]>', '').trim();\n}\n\nfunction extractLinkHref(block) {\n  const match = block.match(/<link[^>]*href=\"([^\"]+)\"/);\n  if (match) return match[1];\n  const fallback = block.match(/<link[^>]*>([^<]+)<\\/link>/);\n  return fallback ? fallback[1].trim() : '';\n}\n\nfunction unwrapLink(link) {\n  try {\n    const u = new URL(link);\n    const real = u.searchParams.get('url');\n    return real || link;\n  } catch (e) {\n    return link;\n  }\n}\n\nlet blocks = [];\nif (raw.includes('<entry>')) {\n  blocks = raw.split('<entry>').slice(1).map(b => b.split('</entry>')[0]);\n} else if (raw.includes('<item>')) {\n  blocks = raw.split('<item>').slice(1).map(b => b.split('</item>')[0]);\n}\n\nconst results = [];\nfor (const block of blocks) {\n  const title = extractTag(block, 'title');\n  const rawLink = extractLinkHref(block);\n  const pubDate = extractTag(block, 'published') || extractTag(block, 'pubDate') || extractTag(block, 'updated');\n  if (!title || !rawLink) continue;\n\n  results.push({\n    json: {\n      signal_id: `${meta.signal_type}_${meta.city}_${Date.now()}_${results.length}`.replace(/[^a-zA-Z0-9_]/g, ''),\n      business_name: title,\n      metro: meta.city,\n      signal_type: meta.signal_type,\n      date_detected: pubDate || new Date().toISOString(),\n      evidence_url: unwrapLink(rawLink),\n      source_query: meta.source_query\n    }\n  });\n}\n\nreturn results;"
      },
